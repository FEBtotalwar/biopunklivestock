<?xml version="1.0" encoding="UTF-8"?>
<Patch>
	<Operation Class="PatchOperationSequence">
		<operations>
			<!-- Wild animal destribution -->
			<li Class="PatchOperationAdd">
				<xpath>/Defs/BiomeDef[defName = "BorealForest" or defName = "TemperateForest"]/pollutionWildAnimals</xpath>
				  <value>
					<FEB_Leadbelly>0.3</FEB_Leadbelly>
					<FEB_Toxoga>0.05</FEB_Toxoga>
				  </value>
			</li> 
			<li Class="PatchOperationAdd">
				<xpath>/Defs/BiomeDef[defName = "Tundra" or defName = "ColdBog" or defName = "TemperateSwarm"]/pollutionWildAnimals</xpath>
				  <value>
					<FEB_Leadbelly>0.15</FEB_Leadbelly>
					<FEB_Toxoga>0.1</FEB_Toxoga>
				  </value>
			</li> 							
			<li Class="PatchOperationAdd">
				<xpath>/Defs/BiomeDef[defName = "AridShrubland"]/pollutionWildAnimals</xpath>
				  <value>
					<FEB_Leadbelly>0.2</FEB_Leadbelly>
					<FEB_Toxoga>0.05</FEB_Toxoga>
				  </value>
			</li>			
		</operations>
	</Operation>
</Patch>